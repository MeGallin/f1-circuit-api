NODE_ENV=development
PORT=3001

# External Supabase session-pooler PostgreSQL URL. Supply real values outside Git.
DATABASE_URL=postgresql://APP_ROLE:REPLACE_ME@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=
CORS_ALLOWED_ORIGINS=https://f1.livenotice.co.uk,http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# Optional automatic current-season Jolpica publication polling.
AUTO_SYNC_ENABLED=false
AUTO_SYNC_INTERVAL_MS=900000
AUTO_SYNC_GRACE_MS=21600000
AUTO_SYNC_WINDOW_MS=86400000
# DB-only catalogue/publication rescan while no race watch window is active.
AUTO_SYNC_RESCAN_MS=21600000

# Optional upstream session enrichment.
OPENF1_ENABLED=false

# Optional server-side question interpretation and fallback rephrasing.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=max
OPENAI_TIMEOUT_MS=10000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
QUESTION_RAG_ENABLED=true
