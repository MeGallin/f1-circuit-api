{
  "name": "f1-circuit-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "node scripts/sync.js",
    "test:postman": "node scripts/run-postman.js",
    "check:contract": "node scripts/check-contract.js",
    "check": "npm run lint && npm run format:check && npm test && npm run check:contract && npm run test:postman"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "newman": "^6.2.2",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2"
  }
}
